@model List<AcademiaPlus.ViewModels.StudentViewModel>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-semibold text-dark border-bottom pb-2 mb-4">
            <i class="bi bi-people-fill text-primary me-2"></i>
            Lista de Estudiantes
        </h2>
        <a href="/Student/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Nuevo Estudiante
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var student in Model)
            {
                <div class="col">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="card-title text-dark mb-1">
                                <i class="bi bi-person-circle"></i> @student.Name @student.Lastname
                            </h5>
                            <p class="mb-1"><i class="bi bi-credit-card"></i> <strong>Documento:</strong> @student.Document</p>
                            <p class="mb-3"><i class="bi bi-envelope"></i> <strong>Correo:</strong> @student.Email</p>

                            <div class="d-flex gap-2 mb-3">
                                <a href="@Url.Action("Edit", "Student", new { id = student.Id })" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a href="@Url.Action("Delete", "Student", new { id = student.Id })" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-trash3"></i> Eliminar
                                </a>
                                <a href="@Url.Action("RegisterSubject", "Student", new { id = student.Id })" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-journal-plus"></i> Inscribir Materia
                                </a>
                            </div>

                            <a href="@Url.Action("Subjects", "Student", new { id = student.Id })" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-journal-text"></i> Ver Materias
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4">No hay estudiantes registrados.</div>
    }
</div>
