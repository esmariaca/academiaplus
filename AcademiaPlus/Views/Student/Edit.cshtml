@using AcademiaPlus.ViewModels
@model StudentViewModel

<h2>Editar Estudiante</h2>

<form asp-controller="Student" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name" class="form-label">@Html.DisplayNameFor(m => m.Name)</label>
        <input name="Name" class="form-control" value="@Model.Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Lastname" class="form-label">@Html.DisplayNameFor(m => m.Lastname)</label>
        <input name="Lastname" class="form-control" value="@Model.Lastname" />
        <span asp-validation-for="Lastname" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Document" class="form-label">@Html.DisplayNameFor(m => m.Document)</label>
        <input name="Document" class="form-control" value="@Model.Document" />
        <span asp-validation-for="Document" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email" class="form-label">@Html.DisplayNameFor(m => m.Email)</label>
        <input name="Email" class="form-control" value="@Model.Email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
</form>
